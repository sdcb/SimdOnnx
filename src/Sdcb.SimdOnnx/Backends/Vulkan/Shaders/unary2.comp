#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Parameterized elementwise unary: mode 0 leaky relu (x >= 0 ? x : a x), 1 tanh, 2 clip(x, a, b)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET x[]; };
layout(set = 0, binding = 1) writeonly buffer O { ET o[]; };

layout(push_constant) uniform PC { uint n, mode; float a, b; } p;

void main()
{
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    if (i >= p.n) return;
    float v = float(x[i]);
    float r;
    if (p.mode == 0u) r = v >= 0.0 ? v : v * p.a;
    else if (p.mode == 1u) r = tanh(clamp(v, -15.0, 15.0));
    else r = min(max(v, p.a), p.b);
    o[i] = ET(r);
}
