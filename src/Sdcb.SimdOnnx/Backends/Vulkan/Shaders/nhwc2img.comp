#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Image session output: NHWC [h][w][3] -> tightly packed u8 (3 or 4 bytes per pixel), the
// ih x iw window at (pt, pl), each value as clamp(int(v * scale + 0.5), 0, 255). One thread packs
// 4 output bytes into one aligned uint: 3 bpp words may straddle pixels; a 4 bpp word is one pixel,
// alpha copied from the (tightly packed, same format) source upload.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET x[]; };
layout(set = 0, binding = 1) writeonly buffer O { uint o[]; };     // packed u8
layout(set = 0, binding = 2) readonly buffer A { uint a[]; };      // packed u8 source

layout(push_constant) uniform PC {
    uint h, w;          // tensor dims
    uint ih, iw;        // image dims
    uint pt, pl;        // crop top/left
    uint nwords;        // 3 bpp: ceil(ih*iw*3 / 4); 4 bpp: ih*iw
    uint bpp;           // 3 or 4 bytes per pixel
    uint swap;          // 1: tensor channel 0 is byte 2 of a pixel
    float scale;
} p;

uint toU8(uint i) { return uint(clamp(float(x[i]) * p.scale + 0.5, 0.0, 255.0)); }

void main()
{
    uint w4 = gl_GlobalInvocationID.x;
    if (w4 >= p.nwords) return;
    uint ob = p.swap * 2u;
    if (p.bpp == 4u)
    {
        uint dy = w4 / p.iw, dx = w4 - dy * p.iw;
        uint i = ((dy + p.pt) * p.w + dx + p.pl) * 3u;
        o[w4] = toU8(i + ob) | (toU8(i + 1u) << 8u) | (toU8(i + 2u - ob) << 16u) | (a[w4] & 0xFF000000u);
        return;
    }
    uint byteIdx = w4 * 4u;
    uint byteTotal = p.ih * p.iw * 3u;
    uint px = byteIdx / 3u, c = byteIdx - px * 3u;
    uint dy = px / p.iw, dx = px - dy * p.iw;
    uint packed = 0u;
    for (uint j = 0u; j < 4u; j++)
    {
        uint val = 0u;
        if (byteIdx < byteTotal)
        {
            uint ch = c == 1u ? 1u : (c == 0u ? ob : 2u - ob);
            val = toU8(((dy + p.pt) * p.w + dx + p.pl) * 3u + ch);
        }
        packed |= val << (j * 8u);
        byteIdx++;
        if (++c == 3u) { c = 0u; if (++dx == p.iw) { dx = 0u; dy++; } }
    }
    o[w4] = packed;
}
