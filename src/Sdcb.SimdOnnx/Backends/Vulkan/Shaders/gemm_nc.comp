#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require
// Register-tiled GEMM for Intel GPUs without cooperative matrices (Xe-LP iGPUs, VkDevice.NcDirect),
// after SimdPaddleOCR's gemm_nc: a BM x BK / BN x BK tile is converted to fp32 once and stored k-major
// in shared memory, the next tile's global loads are issued before the current tile's FMAs, and each
// invocation keeps TM x TN fp32 accumulators. Pin an 8-lane subgroup: wider SIMD spills them (UHD 770:
// SIMD16 is ~4x slower). Bindings and push constants match gemm_cm8.
//   O[m, n] = act(A[m, :] . W[n, :] + bias[n] + R[m, n])
// A fp16 [M][K] rows (1x1 conv input / im2col matrix / Gemm A), W fp16 [Npad][K], K % 4 == 0;
// rows past M and columns past N are masked. fp16 storage only.
// flags: bit0 bias, bit1 residual, bits4-6 act (1 relu, 2 gelu, 3 hardswish, 4 swish)
// -DSIMPLE: act 0 / 1 / 3 only (host-selected), a fully unrolled epilogue. Compiled next to the
// staged epilogue Intel's compiler spills the main loop, so the two are separate binaries.

#define BM 64u
#define BN 64u
#define BK 16u
#define TM 8u
#define TN 8u
#define NTX (BN / TN)
#define NTY (BM / TM)
#define NTHR (NTX * NTY)
#define AK (BK / 4u)
#define AV ((BM * AK + NTHR - 1u) / NTHR)
#define BV ((BN * AK + NTHR - 1u) / NTHR)

layout(local_size_x = NTHR) in;

layout(set = 0, binding = 0) readonly buffer X { f16vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer W { f16vec4 w[]; };
layout(set = 0, binding = 2) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 3) readonly buffer Res { float16_t res[]; };
layout(set = 0, binding = 4) writeonly buffer O { float16_t o[]; };

layout(push_constant) uniform PC { uint mDim; uint nDim; uint kDim; uint flags; } p;

// As = S[0, BK*BM), Bs = S[BK*BM, ...); the staged epilogue reuses S[tid*TN, +TN) (BK*(BM+BN) >= NTHR*TN)
shared float S[BK * (BM + BN)];
#define As(i) S[i]
#define Bs(i) S[BK * BM + (i)]

float ferf(float v)
{
    float s = v < 0.0 ? -1.0 : 1.0;
    float ax = abs(v);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return (1.0 - poly * exp(-ax * ax)) * s;
}

float actf(float v, uint act)
{
    if (act == 1u) return max(v, 0.0);
    if (act == 2u) return 0.5 * v * (1.0 + ferf(v * 0.70710678));
    if (act == 3u) return v * clamp(v * (1.0 / 6.0) + 0.5, 0.0, 1.0);
    if (act == 4u) return v / (1.0 + exp(-v));
    return v;
}

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint tx = tid % NTX;
    uint ty = tid / NTX;
    uint m0 = gl_WorkGroupID.x * BM;
    uint n0 = gl_WorkGroupID.y * BN;
    uint kv = p.kDim >> 2u;

    float acc[TM * TN];
    for (uint i = 0u; i < TM * TN; i++) acc[i] = 0.0;

    f16vec4 z = f16vec4(float16_t(0.0));
    f16vec4 ra[AV];
    f16vec4 rb[BV];
    for (uint t = 0u; t < AV; t++)
    {
        uint e = tid + t * NTHR;
        uint r = e / AK, cv = e - r * AK;
        uint gm = m0 + r, gk = cv * 4u;
        ra[t] = (e < BM * AK && gm < p.mDim && gk < p.kDim) ? x[gm * kv + (gk >> 2u)] : z;
    }
    for (uint t = 0u; t < BV; t++)
    {
        uint e = tid + t * NTHR;
        uint r = e / AK, cv = e - r * AK;
        uint gn = n0 + r, gk = cv * 4u;
        rb[t] = (e < BN * AK && gn < p.nDim && gk < p.kDim) ? w[gn * kv + (gk >> 2u)] : z;
    }

    for (uint k0 = 0u; k0 < p.kDim; k0 += BK)
    {
        for (uint t = 0u; t < AV; t++)
        {
            uint e = tid + t * NTHR;
            if (e < BM * AK)
            {
                uint r = e / AK, cv = e - r * AK;
                vec4 f = vec4(ra[t]);
                As((cv * 4u + 0u) * BM + r) = f.x;
                As((cv * 4u + 1u) * BM + r) = f.y;
                As((cv * 4u + 2u) * BM + r) = f.z;
                As((cv * 4u + 3u) * BM + r) = f.w;
            }
        }
        for (uint t = 0u; t < BV; t++)
        {
            uint e = tid + t * NTHR;
            if (e < BN * AK)
            {
                uint r = e / AK, cv = e - r * AK;
                vec4 f = vec4(rb[t]);
                Bs((cv * 4u + 0u) * BN + r) = f.x;
                Bs((cv * 4u + 1u) * BN + r) = f.y;
                Bs((cv * 4u + 2u) * BN + r) = f.z;
                Bs((cv * 4u + 3u) * BN + r) = f.w;
            }
        }
        barrier();
        uint k1 = k0 + BK;
        if (k1 < p.kDim)
        {
            for (uint t = 0u; t < AV; t++)
            {
                uint e = tid + t * NTHR;
                uint r = e / AK, cv = e - r * AK;
                uint gm = m0 + r, gk = k1 + cv * 4u;
                ra[t] = (e < BM * AK && gm < p.mDim && gk < p.kDim) ? x[gm * kv + (gk >> 2u)] : z;
            }
            for (uint t = 0u; t < BV; t++)
            {
                uint e = tid + t * NTHR;
                uint r = e / AK, cv = e - r * AK;
                uint gn = n0 + r, gk = k1 + cv * 4u;
                rb[t] = (e < BN * AK && gn < p.nDim && gk < p.kDim) ? w[gn * kv + (gk >> 2u)] : z;
            }
        }
        for (uint kk = 0u; kk < BK; kk++)
        {
            float a[TM];
            float b[TN];
            for (uint i = 0u; i < TM; i++) a[i] = As(kk * BM + ty * TM + i);
            for (uint j = 0u; j < TN; j++) b[j] = Bs(kk * BN + tx * TN + j);
            for (uint i = 0u; i < TM; i++)
                for (uint j = 0u; j < TN; j++)
                    acc[i * TN + j] = fma(a[i], b[j], acc[i * TN + j]);
        }
        barrier();
    }

    uint act = (p.flags >> 4) & 7u;
    bool hasBias = (p.flags & 1u) != 0u;
    bool hasRes = (p.flags & 2u) != 0u;
    uint mBase = m0 + ty * TM;
    uint nBase = n0 + tx * TN;
#ifdef SIMPLE
    for (uint i = 0u; i < TM; i++)
    {
        uint gm = mBase + i;
        if (gm >= p.mDim) continue;
        for (uint j = 0u; j < TN; j++)
        {
            uint gn = nBase + j;
            if (gn >= p.nDim) continue;
            float v = acc[i * TN + j];
            if (hasBias) v += bias[gn];
            if (hasRes) v += float(res[gm * p.nDim + gn]);
            if (act == 1u) v = max(v, 0.0);
            if (act == 3u) v *= clamp(v * (1.0 / 6.0) + 0.5, 0.0, 1.0);
            o[gm * p.nDim + gn] = float16_t(v);
        }
    }
#else
    // gelu / swish: one non-unrolled body instead of TM*TN inlined copies (they spill the accumulators)
    for (uint i = 0u; i < TM; i++)
    {
        for (uint j = 0u; j < TN; j++) S[tid * TN + j] = acc[i * TN + j];
        uint gm = mBase + i;
        if (gm >= p.mDim) continue;
        [[dont_unroll]] for (uint j = 0u; j < TN; j++)
        {
            uint gn = nBase + j;
            if (gn >= p.nDim) continue;
            float v = S[tid * TN + j];
            if (hasBias) v += bias[gn];
            if (hasRes) v += float(res[gm * p.nDim + gn]);
            o[gm * p.nDim + gn] = float16_t(actf(v, act));
        }
    }
#endif
}
