<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Sdcb.SimdOnnx.Tests</AssemblyName>
    <RootNamespace>Sdcb.SimdOnnx.Tests</RootNamespace>
    <TargetFramework></TargetFramework>
    <!-- net48 runs the netstandard2.0 build (Vector<T> / scalar tiers) on .NET Framework (Windows only). -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net48</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- hardware-intrinsic kernels and GPU backends are net10.0 only -->
    <Compile Remove="Avx512KernelTests.cs;NeonKernelTests.cs;MtlKernelTests.cs;VkKernelTests.cs;VkDebugTests.cs;VkDeviceLossTests.cs;VkRouteTests.cs;GpuOpTests.cs" />
    <!-- the ONNX conformance manifest is recorded for the net10.0 build -->
    <Compile Remove="Conformance/**" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdOnnx\Sdcb.SimdOnnx.csproj" />
  </ItemGroup>
</Project>
